# ============================================================
# Eber — Biblical & Spoken Hebrew Academy
# Copy this file to .env OR configure keys directly inside
# the app's Settings page (they are saved locally to .env).
# ============================================================

PORT=3001

# Default AI Provider (gemini | openai | anthropic | grok | kimi | qwen)
DEFAULT_AI_PROVIDER=gemini

# Optional Access PIN (recommended if deploying publicly on Vercel with your API keys)
APP_ACCESS_PIN=

# Speech-to-Text (Hebrew Pronunciation & Speaking Practice)
DEEPGRAM_API_KEY=

# Google Gemini (Default Tutor + Cheap Mnemonic Images + Hebrew TTS)
GEMINI_API_KEY=

# Optional Alternative AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
